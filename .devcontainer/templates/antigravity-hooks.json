{
  "hooks": {
    "preToolUse": {
      "command": ".devcontainer/sandbox-bwrap.sh"
    }
  },
  "agent-sandbox": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": ".devcontainer/sandbox-bwrap.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
